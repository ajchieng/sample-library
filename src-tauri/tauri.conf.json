{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sample Tracker",
  "version": "0.1.0",
  "identifier": "com.sampletracker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sample Tracker",
        "width": 1320,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "icons/128x128.png"
    ]
  }
}
